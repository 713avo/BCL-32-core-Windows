# BCL-32 core (Windows) --- Makefile
# Builds bcl.exe (cross-compiled from Linux) and, for development, the native `bcl`. License: GPL-3.0-or-later (see LICENSE).

# Windows build (cross-compiled from Linux):
#   ./tools/install-dev.sh        # installs the Zig toolchain in tools/toolchain
#   make windows                  # -> bin-win/bcl.exe
#   make portable                 # -> dist/bcl-32-<version>-windows-x64.zip
# or with an ordinary mingw-w64 installation:
#   make windows CC=x86_64-w64-mingw32-gcc
CC      ?= gcc
CFLAGS  ?= -Wall -Wextra -g
CFLAGS  += -MMD -MP -I./include
ifdef WIN
EXE     = .exe
# No readline on Windows. Native modules (.bll = DLL) are not supported yet:
# bcl.exe does not export the kernel symbols a module would need.
LDFLAGS += -lm
else
EXE     =
LDFLAGS += -lm -ldl -rdynamic
# readline is optional: used for line editing in the interactive session.
ifneq ($(wildcard /usr/include/readline/readline.h),)
CFLAGS  += -DHAVE_READLINE
LDFLAGS += -lreadline
endif
endif

SRC_DIR = src
BIN_DIR = bin
SRCS = $(SRC_DIR)/main.c $(SRC_DIR)/bcl.c $(SRC_DIR)/lexer.c \
       $(SRC_DIR)/parser.c $(SRC_DIR)/eval.c $(SRC_DIR)/cmd.c \
       $(SRC_DIR)/evtsys.c $(SRC_DIR)/calc.c
OBJS = $(SRCS:$(SRC_DIR)/%.c=$(BIN_DIR)/%.o) $(BIN_DIR)/build_number.o
DEPS = $(OBJS:.o=.d)
TARGET = $(BIN_DIR)/bcl$(EXE)

.DEFAULT_GOAL := all
.PHONY: all clean rebuild help windows portable

help:
	@echo "BCL-32 core (Windows) --- targets"
	@echo "  make windows         cross-compile bin-win/bcl.exe (needs tools/install-dev.sh)"
	@echo "  make portable        build dist/bcl-32-<version>-windows-x64.zip"
	@echo "  make                 build the native bin/bcl (development)"
	@echo "  make clean           remove build output"
	@echo
	@echo "Variables: ZIG (path to zig), CC, CFLAGS"

all: $(TARGET)

ZIG ?= $(CURDIR)/tools/toolchain/zig
ifneq ($(origin CC),command line)
WIN_CC = $(ZIG) cc -target x86_64-windows-gnu
else
WIN_CC = $(CC)
endif
VERSION := $(shell sed -n 's/^\#define BCL_VERSION "\(.*\)"/\1/p' include/bcl.h)
PORTABLE = bcl-32-$(VERSION)-windows-x64

windows:
	$(MAKE) WIN=1 BIN_DIR=bin-win CC="$(WIN_CC)"

# Portable ZIP: bcl.exe + examples + manual + license. No installer needed.
portable: windows
	rm -rf dist/$(PORTABLE) dist/$(PORTABLE).zip
	mkdir -p dist/$(PORTABLE)/examples dist/$(PORTABLE)/doc
	cp bin-win/bcl.exe LICENSE README.md CHANGELOG.md dist/$(PORTABLE)/
	cp examples/*.bcl dist/$(PORTABLE)/examples/
	cp doc/*.md dist/$(PORTABLE)/doc/
	cd dist && zip -qr $(PORTABLE).zip $(PORTABLE)
	@echo "Created dist/$(PORTABLE).zip"

# Build number: the BUILD file (versioned) is bumped whenever the interpreter
# sources change, and shown by `bcl --version`.
$(BIN_DIR)/build_number.c: $(SRCS) $(wildcard include/*.h)
	@mkdir -p $(BIN_DIR)
	@n=$$(cat BUILD 2>/dev/null || echo 0); n=$$((n+1)); echo $$n > BUILD; \
	  printf '/* Generated by make: do not edit. */\nint bcl_build_number(void) { return %s; }\n' $$n > $@; \
	  echo "BCL-32 build $$n"

$(BIN_DIR)/build_number.o: $(BIN_DIR)/build_number.c
	$(CC) $(CFLAGS) -c $< -o $@

$(BIN_DIR)/%.o: $(SRC_DIR)/%.c
	@mkdir -p $(BIN_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(TARGET): Makefile $(OBJS)
	$(CC) $(OBJS) -o $@ $(LDFLAGS)

clean:
	rm -f $(BIN_DIR)/*.o $(BIN_DIR)/*.d $(BIN_DIR)/build_number.c $(TARGET)
	-rmdir $(BIN_DIR)
	rm -f bin-win/*.o bin-win/*.d bin-win/build_number.c bin-win/bcl.exe
	-rmdir bin-win

rebuild: clean all

-include $(DEPS)
